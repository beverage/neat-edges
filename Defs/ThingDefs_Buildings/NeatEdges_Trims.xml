<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The visible trims: a border strip, its corner, the inside corner, the
       double-rail runner, the end cap and the frame. 1×1 non-edifice
       buildings that dress the floor without owning
       the cell, so they coexist with furniture (only edifices wipe edifices)
       and with any terrain, ours or another mod's. Stuffable and paintable.

       Each carries BlocksTerrainFade for the edges its art covers, so a
       decorated strip is also a hard edge: the hardening follows the same
       rules as the invisible marker, two-sided, with corners sealed.

       All six draw from ONE strip texture, laid out as geometry by
       NeatEdges.Graphic_StripTrim: a band along each edge the shape covers,
       cut at 45 degrees where two meet, mapped to world position along the
       band. Each names its shape with a NeatEdges.TrimPiece. The strip's top
       half is the band on a north edge and its bottom half the band on a
       south edge, so west and east arms keep the north-west light by taking
       the matching half. Until 2026-10 each shape shipped a texture per
       facing, 21 in all, kept out of the static atlas by a Harmony patch; the
       strip never enters the atlas, and every trim in a map section draws in
       one call whatever its material or paint. Every def names a uiIconPath:
       without one its build button would show the strip.

       Moved here from Fine Establishments (2026-09-24), where they began, with
       their art and generator (devtools/make_trim_art.py). They were renamed
       from that mod's prefix on the way; its devtools carry a one-time save
       patcher for the old names. defNames are permanent once shipped.

       The border ROTATES to pick its edge rather than linking: a centred
       linked band was built first and rejected in play, because a link mask
       can never say which side its wall is on. -->

  <ThingDef ParentName="BuildingBase">
    <defName>NE_FloorBorder</defName>
    <label>floor border</label>
    <description>A border strip set into the floor along one edge of a tile, running its full length, so a row of them reads as one continuous line. Rotate to choose the edge. The edge it covers stays crisp: terrain stops fading across it. Built from wood, stone or metal, and takes paint.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <!-- The strip, laid out as one arm on the edge Rotation names. A run is
           one strip carried across every joint, mapped to world position. -->
      <texPath>NeatEdges/Trim/FloorBorderStrip</texPath>
      <graphicClass>NeatEdges.Graphic_StripTrim</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>NeatEdges/Trim/FloorBorder_MenuIcon</uiIconPath>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>TerrainScatter</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <destroyable>true</destroyable>
    <clearBuildingArea>false</clearBuildingArea>
    <canOverlapZones>true</canOverlapZones>
    <tradeability>None</tradeability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>150</WorkToBuild>
      <Beauty>1</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>2</costStuffCount>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <!-- Line-drag comes from the Defenses draw styles alone;
         placingDraggableDimensions is a dead field in 1.6. -->
    <drawStyleCategory>Defenses</drawStyleCategory>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2060</uiOrder>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
      <paintable>true</paintable>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <canLandGravshipOn>true</canLandGravshipOn>
    </building>
    <modExtensions>
      <li Class="NeatEdges.BlocksTerrainFade">
        <!-- Measured, not assumed: decoding the art puts the opaque band in
             rows 0-34 of a north edge's 256 (the top 14%), which is the
             strip's top half; Graphic_StripTrim lays it on the edge Rotation
             names. Rotation names the hugged edge directly, with no
             offset. -->
        <edges>
          <li>0</li>
        </edges>
      </li>
      <li Class="NeatEdges.TrimPiece">
        <shape>Straight</shape>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The corner: ONE rotatable def owning both bands of an L, which is what
       lets them join cleanly at all: two separate strips never can, since
       neither knows the other. Its two arms meet in a mitre on the diagonal.
       Facing north it covers the north and east edges, clockwise from there. -->
  <ThingDef ParentName="BuildingBase">
    <defName>NE_FloorBorderCorner</defName>
    <label>floor border corner</label>
    <description>Two border strips joined in an L around one corner of a tile. Rotate to choose which corner. Both edges it covers stay crisp: terrain stops fading across them. Built from wood, stone or metal, and takes paint.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>NeatEdges/Trim/FloorBorderStrip</texPath>
      <graphicClass>NeatEdges.Graphic_StripTrim</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>NeatEdges/Trim/FloorBorderCorner_MenuIcon</uiIconPath>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>TerrainScatter</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <destroyable>true</destroyable>
    <clearBuildingArea>false</clearBuildingArea>
    <canOverlapZones>true</canOverlapZones>
    <tradeability>None</tradeability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>150</WorkToBuild>
      <Beauty>1</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>2</costStuffCount>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2061</uiOrder>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
      <paintable>true</paintable>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <canLandGravshipOn>true</canLandGravshipOn>
    </building>
    <modExtensions>
      <li Class="NeatEdges.BlocksTerrainFade">
        <!-- Two ADJACENT edges, so five directions harden: both cardinals plus
             the three diagonals they flank. North hugs N,E; east E,S; south
             S,W; west W,N. That is offset 0 and +1 in every case, the same
             arms the Corner shape draws. -->
        <edges>
          <li>0</li>
          <li>1</li>
        </edges>
      </li>
      <li Class="NeatEdges.TrimPiece">
        <shape>Corner</shape>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The inside corner: the square a line of strips leaves open where it
       turns around an inside corner, a wall jutting into the room. Each strip
       runs its own tile's full length, so the two on the tiles beside the
       corner meet only at a point and leave a band's width of square open in
       the tile between them. This fills it, carrying both strips' bands on and
       joining them: the band square split on its diagonal, each half the band
       of the neighbour it continues. The facing names the corner as the
       corner's does: north is the north-east square.

       NO BlocksTerrainFade, on purpose. It covers a corner of its tile, not an
       edge, and that corner is already sealed by the two strips beside it:
       corner sealing closes a diagonal whose corner point a neighbour's
       hardened edge closes. The extension with an empty list would be worse
       than none, since empty means all four edges.

       Costs a fraction of a strip, being a band's width square. -->
  <ThingDef ParentName="BuildingBase">
    <defName>NE_FloorBorderInsideCorner</defName>
    <label>floor border inside corner</label>
    <description>The small square that completes a border where it turns around an inside corner, such as a wall jutting into the room. Border strips each run their own tile's full length, so two meeting around an inside corner leave a notch between them; this fills it and joins them. Rotate to choose which corner. It keeps no edge crisp by itself, since the strips on either side already do. Built from wood, stone or metal, and takes paint.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>NeatEdges/Trim/FloorBorderStrip</texPath>
      <graphicClass>NeatEdges.Graphic_StripTrim</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <!-- The piece alone is a small square in one corner, a few pixels on a
         menu button; the icon draws the whole bend it completes. -->
    <uiIconPath>NeatEdges/Trim/FloorBorderInsideCorner_MenuIcon</uiIconPath>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>TerrainScatter</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <destroyable>true</destroyable>
    <clearBuildingArea>false</clearBuildingArea>
    <canOverlapZones>true</canOverlapZones>
    <tradeability>None</tradeability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <WorkToBuild>50</WorkToBuild>
      <Beauty>0</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>1</costStuffCount>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2062</uiOrder>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
      <paintable>true</paintable>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <canLandGravshipOn>true</canLandGravshipOn>
    </building>
    <modExtensions>
      <!-- Its shape only. No BlocksTerrainFade, as above. -->
      <li Class="NeatEdges.TrimPiece">
        <shape>InsideCorner</shape>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The runner: both opposite edges in one piece, `| |`, or `=` turned a
       quarter. Drag it down a corridor and the floor between the rails reads
       as a runner.

       ONE def covers both orientations because the figure is 180°-symmetric:
       north is south's figure and west is east's. Each rail is an arm on its
       own edge, so each takes the strip's half for that edge and the two are
       lit as the straights beside them are.

       Two straights at DIFFERENT rotations also stack on one cell (the
       engine's identical-thing gate skips anything whose rotation differs),
       so this def exists for the ergonomics: one building instead of two,
       one drag instead of two remembered rotations, and one image owning
       both rails.

       Costs are DOUBLED against the straight on purpose: a runner is two bands
       of material, and pricing it as one would make the convenient route also
       the cheap one. -->
  <ThingDef ParentName="BuildingBase">
    <defName>NE_FloorBorderDouble</defName>
    <label>floor runner border</label>
    <description>A pair of border strips set into the floor along opposite edges of a tile, each running its full length. Lay a line of them down a corridor and the floor between the rails reads as a runner. Rotate to choose which pair of edges. Both edges stay crisp: terrain stops fading across them. Built from wood, stone or metal, and takes paint.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>NeatEdges/Trim/FloorBorderStrip</texPath>
      <graphicClass>NeatEdges.Graphic_StripTrim</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>NeatEdges/Trim/FloorBorderDouble_MenuIcon</uiIconPath>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>TerrainScatter</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <destroyable>true</destroyable>
    <clearBuildingArea>false</clearBuildingArea>
    <canOverlapZones>true</canOverlapZones>
    <tradeability>None</tradeability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>300</WorkToBuild>
      <Beauty>2</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>4</costStuffCount>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2063</uiOrder>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
      <paintable>true</paintable>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <canLandGravshipOn>true</canLandGravshipOn>
    </building>
    <modExtensions>
      <li Class="NeatEdges.BlocksTerrainFade">
        <!-- Two OPPOSITE edges, so six directions harden: both cardinals and
             all four diagonals. North and south both hug N,S; east and west
             both hug E,W. Offset 0 and +2, the Runner shape's arms. -->
        <edges>
          <li>0</li>
          <li>2</li>
        </edges>
      </li>
      <li Class="NeatEdges.TrimPiece">
        <shape>Runner</shape>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The end cap: three strips in a U, closing a runner or a path one tile
       wide. The facing names the CLOSED end, so a cap facing north closes a
       run that comes up from the south.

       Three arms, mitred where the closed end meets each side. Priced as
       three straights, by the runner's rule that the convenient piece is not
       also the cheap one. -->
  <ThingDef ParentName="BuildingBase">
    <defName>NE_FloorBorderEndCap</defName>
    <label>floor border end cap</label>
    <description>Three border strips joined in a U around one tile, closing off the end of a runner or of a path one tile wide. Rotate to choose the closed end. All three edges it covers stay crisp: terrain stops fading across them. Built from wood, stone or metal, and takes paint.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>NeatEdges/Trim/FloorBorderStrip</texPath>
      <graphicClass>NeatEdges.Graphic_StripTrim</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>NeatEdges/Trim/FloorBorderEndCap_MenuIcon</uiIconPath>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>TerrainScatter</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <destroyable>true</destroyable>
    <clearBuildingArea>false</clearBuildingArea>
    <canOverlapZones>true</canOverlapZones>
    <tradeability>None</tradeability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Beauty>3</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>6</costStuffCount>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2064</uiOrder>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
      <paintable>true</paintable>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <canLandGravshipOn>true</canLandGravshipOn>
    </building>
    <modExtensions>
      <li Class="NeatEdges.BlocksTerrainFade">
        <!-- The facing and the edges either side of it: north hugs W,N,E; east
             N,E,S; south E,S,W; west S,W,N. Offsets -1, 0 and +1, with -1
             written as 3, the EndCap shape's arms. -->
        <edges>
          <li>3</li>
          <li>0</li>
          <li>1</li>
        </edges>
      </li>
      <li Class="NeatEdges.TrimPiece">
        <shape>EndCap</shape>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The frame: a strip around all four edges, one framed tile, for a
       stepping stone or a plinth. It never rotates. Even when code sets a
       rotation (GenSpawn leaves a non-rotatable thing's rotation as given) it
       draws the same: four arms cover all four edges whatever the rotation,
       and each takes the strip's half for the edge it lands on, so the light
       cannot come from the wrong side. It drags like the straight, so a row
       or a block of framed tiles is one order. Priced as four straights. -->
  <ThingDef ParentName="BuildingBase">
    <defName>NE_FloorBorderFrame</defName>
    <label>floor border frame</label>
    <description>A border strip around all four edges of one tile, framing it, for a stepping stone or the base of a statue. All four edges stay crisp: terrain stops fading across them. Built from wood, stone or metal, and takes paint.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>NeatEdges/Trim/FloorBorderStrip</texPath>
      <graphicClass>NeatEdges.Graphic_StripTrim</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>NeatEdges/Trim/FloorBorderFrame_MenuIcon</uiIconPath>
    <rotatable>false</rotatable>
    <altitudeLayer>TerrainScatter</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <destroyable>true</destroyable>
    <clearBuildingArea>false</clearBuildingArea>
    <canOverlapZones>true</canOverlapZones>
    <tradeability>None</tradeability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Beauty>4</Beauty>
      <Flammability>0.5</Flammability>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>8</costStuffCount>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2065</uiOrder>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
      <paintable>true</paintable>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <canLandGravshipOn>true</canLandGravshipOn>
    </building>
    <modExtensions>
      <li Class="NeatEdges.BlocksTerrainFade">
        <!-- All four, written out: an empty list means the same, but four
             explicit edges say it where the next reader looks. -->
        <edges>
          <li>0</li>
          <li>1</li>
          <li>2</li>
          <li>3</li>
        </edges>
      </li>
      <li Class="NeatEdges.TrimPiece">
        <shape>Frame</shape>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
